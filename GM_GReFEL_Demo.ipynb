    "# ── Cell 6: Gradio UI ─────────────────────────────────────────────────────────\n",
    "import gradio as gr\n",
    "\n",
    "# ── Static image inference ────────────────────────────────────────────────────\n",
    "def infer_image(pil_img):\n",
    "    if pil_img is None:\n",
    "        return 'No image provided', {}, None, None\n",
    "    rgb = np.array(pil_img.convert('RGB'))\n",
    "    label, probs, cam, lm = run_inference([rgb])\n",
    "    return label, probs, Image.fromarray(cam), Image.fromarray(lm)\n",
    "\n",
    "# ── Webcam (video) inference ──────────────────────────────────────────────────\n",
    "def infer_video(video_path):\n",
    "    if video_path is None:\n",
    "        return 'No video provided', {}, None, None\n",
    "    cap = cv2.VideoCapture(video_path)\n",
    "    frames = []\n",
    "    total  = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n",
    "    step   = max(1, total // NUM_FRAMES)\n",
    "    while len(frames) < NUM_FRAMES:\n",
    "        cap.set(cv2.CAP_PROP_POS_FRAMES, len(frames) * step)\n",
    "        ret, frm = cap.read()\n",
    "        if not ret: break\n",
    "        frames.append(cv2.cvtColor(frm, cv2.COLOR_BGR2RGB))\n",
    "    cap.release()\n",
    "    if not frames:\n",
    "        return 'Could not read video', {}, None, None\n",
    "    label, probs, cam, lm = run_inference(frames)\n",
    "    return label, probs, Image.fromarray(cam), Image.fromarray(lm)\n",
    "\n",
    "# ── Webcam snapshot inference ─────────────────────────────────────────────────\n",
    "def infer_webcam(pil_img):\n",
    "    return infer_image(pil_img)\n",
    "\n",
    "# ── Build Gradio blocks ───────────────────────────────────────────────────────\n",
    "with gr.Blocks(\n",
    "    title='GM-GReFEL Demo',\n",
    "    theme=gr.themes.Soft(primary_hue='indigo', secondary_hue='purple'),\n",
    "    css='''\n",
    "        .header { text-align: center; padding: 20px 0; }\n",
    "        .header h1 { font-size: 2em; font-weight: 800; color: #3730a3; }\n",
    "        .header p  { color: #555; max-width: 700px; margin: 0 auto; }\n",
    "        .result-label { font-size: 2em !important; font-weight: 800 !important;\n",
    "                        text-align: center; padding: 10px; background: #eef2ff;\n",
    "                        border-radius: 12px; }\n",
    "    '''\n",
    ") as demo:\n",
    "\n",
    "    gr.HTML('''\n",
    "        <div class=\"header\">\n",
    "          <h1>🧠 GM-GReFEL</h1>\n",
    "          <p>A Geometry-Aware Spatiotemporal State-Space Architecture for\n",
    "             Dynamic Facial Expression Recognition in the Wild</p>\n",
    "          <p style=\"margin-top:6px; font-size:0.85em; color:#888;\">\n",
    "             Yudhistira Arditya Pratama &amp; Yi-Zeng Hsieh &nbsp;·&nbsp; NTUST &nbsp;·&nbsp;\n",
    "             IEEE Transactions on Image Processing (under review)\n",
    "          </p>\n",
    "        </div>\n",
    "    ''')\n",
    "\n",
    "    with gr.Tabs():\n",
    "\n",
    "        # ── Tab 1: Static Image ──────────────────────────────────────────────\n",
    "        with gr.Tab('📷 Static Image'):\n",
    "            gr.Markdown('Upload a face image. The model replicates it across 16 frames to simulate a static expression clip.')\n",
    "            with gr.Row():\n",
    "                with gr.Column(scale=1):\n",
    "                    img_in  = gr.Image(label='Input Image', type='pil', height=280)\n",
    "                    img_btn = gr.Button('🔍 Analyze Expression', variant='primary')\n",
    "                with gr.Column(scale=2):\n",
    "                    img_label = gr.Label(label='Predicted Emotion')\n",
    "                    img_probs = gr.Label(label='Confidence per Class', num_top_classes=7)\n",
    "            with gr.Row():\n",
    "                img_cam = gr.Image(label='GradCAM Attention Map', height=250)\n",
    "                img_lm  = gr.Image(label='GM-GReFEL Landmark Overlay', height=250)\n",
    "            img_btn.click(infer_image,\n",
    "                          inputs=[img_in],\n",
    "                          outputs=[img_label, img_probs, img_cam, img_lm])\n",
    "\n",
    "        # ── Tab 2: Video Upload ──────────────────────────────────────────────\n",
    "        with gr.Tab('🎬 Video Upload'):\n",
    "            gr.Markdown('Upload a short video clip. The model samples 16 evenly-spaced frames from it.')\n",
    "            with gr.Row():\n",
    "                with gr.Column(scale=1):\n",
    "                    vid_in  = gr.Video(label='Input Video', height=280)\n",
    "                    vid_btn = gr.Button('🔍 Analyze Expression', variant='primary')\n",
    "                with gr.Column(scale=2):\n",
    "                    vid_label = gr.Label(label='Predicted Emotion')\n",
    "                    vid_probs = gr.Label(label='Confidence per Class', num_top_classes=7)\n",
    "            with gr.Row():\n",
    "                vid_cam = gr.Image(label='GradCAM Attention Map', height=250)\n",
    "                vid_lm  = gr.Image(label='GM-GReFEL Landmark Overlay', height=250)\n",
    "            vid_btn.click(infer_video,\n",
    "                          inputs=[vid_in],\n",
    "                          outputs=[vid_label, vid_probs, vid_cam, vid_lm])\n",
    "\n",
    "        # ── Tab 3: Webcam ────────────────────────────────────────────────────\n",
    "        with gr.Tab('📹 Webcam'):\n",
    "            gr.Markdown('Capture a snapshot from your webcam and analyze the expression.')\n",
    "            with gr.Row():\n",
    "                with gr.Column(scale=1):\n",
    "                    cam_in  = gr.Image(source='webcam', type='pil', label='Webcam Snapshot', streaming=False, height=280)\n",
    "                    cam_btn = gr.Button('🔍 Analyze Expression', variant='primary')\n",
    "                with gr.Column(scale=2):\n",
    "                    cam_label = gr.Label(label='Predicted Emotion')\n",
    "                    cam_probs = gr.Label(label='Confidence per Class', num_top_classes=7)\n",
    "            with gr.Row():\n",
    "                cam_cam = gr.Image(label='GradCAM Attention Map', height=250)\n",
    "                cam_lm  = gr.Image(label='GM-GReFEL Landmark Overlay', height=250)\n",
    "            cam_btn.click(infer_webcam,\n",
    "                          inputs=[cam_in],\n",
    "                          outputs=[cam_label, cam_probs, cam_cam, cam_lm])\n",
    "\n",
    "    gr.Markdown('''\n",
    "    ---\n",
    "    **About this demo**\n",
    "    - **Model:** GM-GReFEL trained on DFEW (Fold 5 checkpoint, 67.02% UAR / 77.14% WAR)\n",
    "    - **Emotions:** Happy 😄 · Sad 😢 · Neutral 😐 · Angry 😠 · Surprise 😲 · Disgust 🤢 · Fear 😨\n",
    "    - **Attention:** GradCAM input-gradient maps show which facial regions drive the prediction\n",
    "    - **Landmarks:** MediaPipe 478-point face mesh with GM-GReFEL colour-coded anatomy groups\n",
    "    - **GitHub:** [ardiytama/GroupMamba-DFER](https://github.com/ardiytama/GroupMamba-DFER)\n",
    "    ''')\n",
    "\n",
    "print('Launching Gradio...')\n",
    "demo.launch(share=True, server_port=7860)\n"
   ]
  }
 ]
}"
